FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

scale   1;

vertices
(
    (-2.0 -2.0 -1.0) // 0: xMin, yMin, zMin
    ( 4.0 -2.0 -1.0) // 1: xMax, yMin, zMin
    ( 4.0  2.0 -1.0) // 2: xMax, yMax, zMin
    (-2.0  2.0 -1.0) // 3: xMin, yMax, zMin
    (-2.0 -2.0  1.0) // 4: xMin, yMin, zMax
    ( 4.0 -2.0  1.0) // 5: xMax, yMin, zMax
    ( 4.0  2.0  1.0) // 6: xMax, yMax, zMax
    (-2.0  2.0  1.0) // 7: xMin, yMax, zMax
);

blocks
(
    hex (0 1 2 3 4 5 6 7) (60 40 20) simpleGrading (1 1 1)
);

edges
();

boundary
(
    xMin { type patch; faces ((0 4 7 3)); }
    xMax { type patch; faces ((1 2 6 5)); }
    yMin { type patch; faces ((0 1 5 4)); }
    yMax { type patch; faces ((3 7 6 2)); }
    zMin { type patch; faces ((0 3 2 1)); }
    zMax { type patch; faces ((4 5 6 7)); }
);