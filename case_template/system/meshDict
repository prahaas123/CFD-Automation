FoamFile
{
    version   2.0;
    format    ascii;
    class     dictionary;
    location  "system";
    object    meshDict;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

surfaceFile "combined.fms";
maxCellSize 0.1;
boundaryCellSize 0.1;

localRefinement
{
    Wing
    {
        cellSize 0.005;
        refinementThickness 0.03;
    }
}

boundaryLayers
{
    nLayers 0;

    patchBoundaryLayers
    {
        Wing
        {
            nLayers 5;
            thicknessRatio 1.2;
            maxFirstLayerThickness 0.0005;
            allowExposedEdges true;
        }
    }

    optimiseLayer 1;
    untangleLayers 1;
}

objectRefinements
{
    wakeRegion
    {
        type        box;
        centre      (1.1 0 0);
        lengthX     2.0;
        lengthY     1.0;
        lengthZ     0.4;
        cellSize    0.02;
    }
}

meshQualityControls
{
    maxNonOrthogonality 65;
    maxSkewness 4;
    minTetQuality 1e-15;
    minVol 1e-13;

    nSmoothScale 4; 
    nSmoothNormals 3; 
    nSmoothSurface 3;
}